{
  "name": "dsh-boot-anim",
  "version": "2.0.0",
  "description": "DSH boot splash for Windows desktop: custom video or image, configurable cold-white flash/ring/scanline layer, and a visual settings panel.",
  "type": "module",
  "main": "lib/index.js",
  "license": "GPL-3.0-only",
  "files": [
    "lib",
    "cordis.patch.yml",
    "config.jsonc",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "docs",
    "media",
    "sfx",
    "tools",
    "安装.bat",
    "安装.ps1",
    "安装说明.txt"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "author": "1512750689-collab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1512750689-collab/DSH-.git"
  },
  "homepage": "https://github.com/1512750689-collab/DSH-#readme",
  "bugs": {
    "url": "https://github.com/1512750689-collab/DSH-/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "boot-animation",
    "splash",
    "ui",
    "windows"
  ],
  "engines": {
    "dsh": ">=0.1.5-rc.1",
    "node": ">=18"
  },
  "os": [
    "win32"
  ]
}
